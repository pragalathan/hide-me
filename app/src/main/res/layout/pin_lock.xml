<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.04"
            android:text="@string/developed_by"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pin_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/pin_dot_empty" />
        </LinearLayout>

        <TextView
            android:id="@+id/pin_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:minHeight="22dp"
            android:textColor="@color/hidden"
            android:textSize="15sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alignmentMode="alignBounds"
            android:columnCount="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_1"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_2"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_3"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_4"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_5"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_6"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_7"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_8"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_9"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="9" />

            <Space
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_0"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_delete"
                style="@style/Widget.HideMe.Key"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:contentDescription="@string/pin_delete"
                android:text="@string/pin_delete"
                android:textSize="16sp" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
